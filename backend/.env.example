# Copy this file to .env and fill in your real values.
# Never commit the filled-in .env file — it is listed in .gitignore.

# Get a free Groq API key at: https://console.groq.com → API Keys
GROQ_API_KEY=

# LangSmith tracing — set LANGCHAIN_TRACING_V2=true to enable.
# Get your API key at https://smith.langchain.com → Settings → API Keys.
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=equity-research

# Path to the FAISS index directory created by ingest.py.
# IMPORTANT: if you switch embedding models, delete the old index and re-run ingest.py.
FAISS_INDEX_PATH=./indexes/sample
